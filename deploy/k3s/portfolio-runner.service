[Unit]
Description=Portfolio production deployment runner
After=network-online.target k3s.service
Wants=network-online.target

[Service]
User=portfolio-deploy
Group=portfolio-deploy
WorkingDirectory=/opt/portfolio-runner
ExecStart=/opt/portfolio-runner/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
