    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "app-ingress",
        "namespace": "portfolio"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "app"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "nginx"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 3000
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
