{
  "name": "portfolio-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:cms": "node --import ./scripts/cms-test-runtime.mjs --import tsx --test tests/cms.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.13",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "openid-client": "6.8.8",
    "pg": "^8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/browser-chromium": "1.64.1",
    "@playwright/test": "1.64.1",
    "@portfolio/next-root-glob": "file:tooling/next-root-glob",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "monocart-coverage-reports": "^2.13.0",
    "playwright": "1.64.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "fast-uri": "3.1.9",
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "@next/eslint-plugin-next": {
      "fast-glob": "$@portfolio/next-root-glob"
    }
  }
}
